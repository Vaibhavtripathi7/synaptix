# Copy to .env. Everything has working defaults.
# A server-side Gemini key is optional: set it for a personal instance; leave it unset on a public
# one so every user brings their own key (sent per request, never stored).

# --- Gemini (pick one backend) ---
SYNAPTIX_GEMINI_BACKEND=api_key          # api_key | vertex
SYNAPTIX_GOOGLE_API_KEY=                 # AI Studio key (api_key backend)
# SYNAPTIX_LLM_MODEL=gemini-3.5-flash      # fast model (enrichment, Q&A)
# SYNAPTIX_LLM_MODEL_STRONG=gemini-pro-latest  # analysis agents; use a flash model on free-tier keys
# SYNAPTIX_GCP_PROJECT=your-project-id   # vertex backend; auth via `gcloud auth application-default login`
# SYNAPTIX_GCP_LOCATION=us-central1

# --- Retrieval stack (defaults are fully managed; switch to local for self-hosted models) ---
# SYNAPTIX_EMBEDDING_PROVIDER=gemini     # gemini | local  (local needs: uv sync --extra local)
# SYNAPTIX_RERANKER=llm                  # llm | local | none

# --- Access ---
# SYNAPTIX_API_KEYS=key1,key2               # bearer keys for /api/*; empty = open (dev only)

# --- Blob storage: a local directory by default; S3-compatible once API and workers run on
#     separate machines (the values below match the `s3` service in docker-compose.yml) ---
# SYNAPTIX_STORAGE_BACKEND=s3
# SYNAPTIX_S3_ENDPOINT_URL=http://localhost:9005
# SYNAPTIX_S3_BUCKET=synaptix
# SYNAPTIX_S3_ACCESS_KEY=synaptix
# SYNAPTIX_S3_SECRET_KEY=synaptix-dev-secret

# --- Infra (defaults match docker-compose.yml) ---
# SYNAPTIX_DATABASE_URL=postgresql+asyncpg://synaptix:synaptix@localhost:5433/synaptix
# SYNAPTIX_REDIS_URL=redis://localhost:6380/0
# SYNAPTIX_ENV=dev                       # dev | test | prod (prod = JSON logs)
