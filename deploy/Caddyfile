# Public entry point: automatic HTTPS, security headers, and load balancing across API replicas.
{$DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 110MB  # the API caps uploads at 100 MB; refuse anything larger here, cheaply
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# The browser holds the user's Gemini key and workspace token. If injected markup ever
		# got past the sanitiser, this still blocks inline script and any request to another
		# origin — which is how a stolen key would leave the page.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' blob: data:; connect-src 'self'; worker-src 'self' blob: https://cdnjs.cloudflare.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# The metrics ports are never published; this path does not exist publicly either.
	respond /metrics* 404

	reverse_proxy {
		# Every API replica, discovered through Docker's DNS and refreshed, so scaling the
		# `api` service needs no proxy change.
		dynamic a {
			name api
			port 8000
			refresh 10s
		}
		lb_policy least_conn
		lb_try_duration 5s  # a replica that is down or restarting: try another
		fail_duration 30s   # and stop sending it traffic for a while
		flush_interval -1   # answers stream as Server-Sent Events; never buffer them
	}
}
