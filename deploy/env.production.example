# Copy to .env on the server (repository root) and fill in. Never commit the real file.

DOMAIN=synaptix.example.duckdns.org      # the public hostname pointing at this VM
POSTGRES_PASSWORD=                       # generate: openssl rand -base64 32

# Leave SYNAPTIX_GOOGLE_API_KEY unset: on a public instance every user brings their own key,
# and requests without one are refused before anything is queued.

# Optional: object storage instead of the local volume. Required once the API and workers run on
# more than one machine. Any S3-compatible service works (S3, Cloudflare R2, GCS interop, MinIO).
# SYNAPTIX_STORAGE_BACKEND=s3
# SYNAPTIX_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# SYNAPTIX_S3_BUCKET=synaptix
# SYNAPTIX_S3_ACCESS_KEY=
# SYNAPTIX_S3_SECRET_KEY=
